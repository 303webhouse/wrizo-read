# Wrizo | Read — API environment. Copy to .env and fill in. Never commit .env.
HOST=0.0.0.0
PORT=8080

# Postgres 16 (Railway in production; local Postgres for dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wrizo_read

# S3-compatible object storage (Railway bucket or Cloudflare R2). No filesystem snapshots.
# All four are REQUIRED in production; an incomplete config fails closed at startup.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# For dev/test WITHOUT S3 only: opt in to the in-memory object store. Never set in production —
# snapshots would live only in memory and vanish on restart (the Archive must not lie by omission).
# ALLOW_MEMORY_STORAGE=true
