# Wrizo | Read — API environment. Copy to .env and fill in. Never commit .env.
HOST=0.0.0.0
PORT=8080

# Postgres 16 (Railway in production; local Postgres for dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wrizo_read

# S3-compatible object storage (Railway bucket or Cloudflare R2). No filesystem snapshots.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
